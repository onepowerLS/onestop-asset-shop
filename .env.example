# OneStop Asset Shop - Environment Configuration
# Copy this file to .env and update with your production values
# NEVER commit .env to Git!

# Database Configuration
DB_HOST=localhost
DB_NAME=onestop_asset_shop
DB_USER=onestop_user
DB_PASS=your_secure_password_here

# Shared auth with PR system (Firebase)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=pr-system-4ea55
FIREBASE_ADMIN_BEARER_TOKEN=
# Optional: server-to-server access to load-out manifest API (with FIREBASE_ADMIN_BEARER_TOKEN)
LOADOUT_MANIFEST_API_KEY=
# UGP → AM inventory sync API (optional; see docs/UGP_AM_PART_ALIGNMENT.md)
UGP_PARTS_SYNC_API_KEY=
# Read API consumer keys for /api/v1/* (X-API-Key). Provision ugridpredict for the forecast service.
AM_API_KEY_UGRIDPREDICT=
AM_API_KEY_NEXUS=
AM_API_KEY_REPORTING=
# Optional JSON map of extra consumers: {"other":"secret"}
# AM_INTEGRATION_API_KEYS=
# Optional: curl ?secret= for web/cron/purge-asset-purgatory.php + canonical-sync.php
CRON_SECRET=
ALLOW_INSECURE_SSL_LOCAL=true

# Canonical data sync (API-based distribution from PR/HR/FM into am_reference_* cache)
# See docs/CANONICAL_DATA_SYNC_PLAN.md
PR_CATALOG_API_KEY=
HR_API_KEY_AM_PORTAL=
FLEET_INTEGRATION_API_KEY=
# Optional: PR fanout receiver (web/api/sync/site-ingest.php)
SITE_SYNC_FANOUT_API_KEY=
# Optional per-type TTL overrides (seconds); defaults: sites=900, orgs/countries=86400, employees/departments/vehicles=3600
# AM_CANONICAL_TTL_EMPLOYEES=3600
# Optional: FM org filter (default 1pwr_lesotho)
# AM_CANONICAL_FM_ORG=1pwr_lesotho

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://assets.1pwrafrica.com

# Session Configuration
SESSION_LIFETIME=7200

# Security
APP_KEY=generate_a_random_32_character_string_here

# Email Configuration (for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@1pwrafrica.com

# AWS Configuration (if using S3 for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
